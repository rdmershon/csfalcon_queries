(#event_simpleName=ActiveDirectoryAccountLocked OR #event_simpleName=ActiveDirectoryAuthenticationFailure)
| ComputerName=/###XXX/i OR SourceEndpointHostName=/###XXX/i OR TargetServerHostName=/###XXX/i
| $falcon/helper:enrich(field=ActiveDirectoryAuthenticationMethod)
| $falcon/helper:enrich(field=AuthenticationFailureMsErrorCode)
| formatTime(format="%Y-%m-%d %H:%M:%S", field=ContextTimeStamp, as=EventTime)
| groupBy([
    #event_simpleName,
    SamAccountName,
    SourceAccountUserName,
    AccountDomain,
    SourceAccountDomain,
    SourceEndpointHostName,
    SourceEndpointAddressIP4,
    ActiveDirectoryAuthenticationMethod,
    AuthenticationFailureMsErrorCode
  ],
  function=[
    count(as=Count),
    selectFromMax(field=ContextTimeStamp, include=[EventTime])
  ])
| sort(Count, order=desc)

//This pivots lockouts back to the failed authentication attempts that typically trigger them (bad passwords, expired credentials, etc.), grouped by:

//Who: SourceAccountUserName / SamAccountName
//Where from: SourceEndpointHostName and SourceEndpointAddressIP4
//How: ActiveDirectoryAuthenticationMethod (Kerberos/NTLM)
//Why: AuthenticationFailureMsErrorCode (wrong password, locked out, etc.)
